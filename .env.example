SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=prosane_local
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Email (reset de contraseña). En dev dejar EMAIL_BACKEND=console (imprime en
# terminal). En producción usar smtp real.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@prosane.gob.ar
# URL de ingreso en los mails de contraseña temporal (cambiar al dominio real)
LOGIN_URL=https://prosane.salta.gob.ar/login

# Bootstrap del primer superadmin en producción (solo deploy inicial).
# Con estas variables, `python manage.py createsuperuser --noinput` crea el
# superadmin sin interactuar. NUNCA commitear valores reales.
# DJANGO_SUPERUSER_EMAIL=admin@prosane.salta.gob.ar
# DJANGO_SUPERUSER_PASSWORD=cambiar-esta-clave
# (Opcional) DJANGO_SUPERUSER_first_name / DJANGO_SUPERUSER_last_name si el
# UserManager los requiriera. Tras el primer login, cambiar la contraseña
# desde la app. Los siguientes superadmins se crean desde
# /api/v1/usuarios/superadmins/ (solo superadmin, con auditoría).

# Integraciones nacionales directas (camino B: Federador + Bus MSAL).
# Sin esto, REFEPS_MOCK=True y validar-dni responde 503. NUNCA commitear
# valores reales: los provee el administrador de RENAPER/SISA-MSAL.
FEDERADOR_BASE_URL=https://federador.msal.gob.ar/masterfile-federacion-service/api
FEDERADOR_DOMINIO=DOMINIOSINAUTORIZACIONDEALTA
FEDERADOR_USUARIO=
FEDERADOR_CLAVE=
BUS_BASE_URL=https://bus.msal.gob.ar
BUS_ISSUER=
BUS_SECRET=
BUS_SCOPE=Practitioner/*.read
BUS_NAME=
BUS_IDENT=
BUS_ROLE=
